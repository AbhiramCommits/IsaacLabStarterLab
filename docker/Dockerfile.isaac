# GPU-host-only Isaac Sim track. Build on an NVIDIA host with the NVIDIA
# Container Toolkit installed:
#
#   docker build -f docker/Dockerfile.isaac -t isaac-starter-lab:gpu .
#
# Run it with the GPU visible and the Omniverse caches mounted so shader and
# extension caches survive container restarts:
#
#   docker run --rm -it --gpus all \
#     --network host \
#     -e ACCEPT_EULA=Y -e PRIVACY_CONSENT=Y \
#     -e LAB_BACKEND=isaac -e LAB_BRIDGE=ros2 \
#     -v "$HOME/.cache/ov:/root/.cache/ov" \
#     -v "$HOME/.cache/pip:/root/.cache/pip" \
#     -v "$HOME/.cache/nvidia:/root/.cache/nvidia" \
#     -v "$HOME/.local/share/ov:/root/.local/share/ov" \
#     -v "$PWD/artifacts:/lab/artifacts" \
#     isaac-starter-lab:gpu
#
# Isaac Sim 4.5.0 requires an NVIDIA driver >= 535.129.03 (see the version
# matrix in docs/LAB_GUIDE.md) and a GPU with >= 16 GB VRAM for this scene.
#
# Do NOT install requirements.lock.txt here: it pins usd-core and numpy, which
# would replace the pxr and numpy that Isaac Sim ships and break Omniverse.
# Only the two runtime dependencies the lab adds are installed, without deps.

FROM nvcr.io/nvidia/isaac-sim:4.5.0

ENV ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y \
    LAB_BACKEND=isaac \
    LAB_BRIDGE=ros2 \
    PYTHONUNBUFFERED=1

WORKDIR /lab

COPY requirements.lock.txt ./
RUN /isaac-sim/python.sh -m pip install --no-cache-dir --no-deps \
        pillow==12.0.0 PyYAML==6.0.3

COPY . .
RUN /isaac-sim/python.sh -m pip install --no-cache-dir --no-deps -e .

CMD ["/isaac-sim/python.sh", "-m", "isaac_starter_lab.cli", "episode", \
     "--backend", "isaac", "--bridge", "ros2", "--seed", "7"]
