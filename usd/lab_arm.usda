#usda 1.0
(
    defaultPrim = "/World/RobotIsaac"
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def Xform "RobotIsaac" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom bool physxArticulation:enabledSelfCollisions = 0

        def "Looks"
        {
            def Material "PhysicsMat" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 1.2
                float physics:restitution = 0
                float physics:staticFriction = 1.2
            }
        }

        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.5
            double3 xformOp:translate = (0, -0.32, 0.75)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Column"
            {
                double size = 1
                float3 xformOp:scale = (0.07, 0.07, 0.35)
                double3 xformOp:translate = (0, 0, 0.175)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def PhysicsFixedJoint "anchor"
        {
            rel physics:body1 = </World/RobotIsaac/base>
            point3f physics:localPos0 = (0, -0.32, 0.75)
            point3f physics:localPos1 = (0, 0, 0)
        }

        def Xform "link0" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.1
            double3 xformOp:translate = (0, -0.32, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Visual" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
                float3 xformOp:scale = (0.06, 0.06, 0.06)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "link1" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.02
            double3 xformOp:translate = (0, -0.32, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Visual" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
                float3 xformOp:scale = (0.3, 0.045, 0.045)
                double3 xformOp:translate = (0.15, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "link2" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.02
            double3 xformOp:translate = (0.3, -0.32, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Visual" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
                float3 xformOp:scale = (0.3, 0.04, 0.04)
                double3 xformOp:translate = (0.15, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "wrist" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.01
            double3 xformOp:translate = (0.6, -0.32, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Visual" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
                float3 xformOp:scale = (0.06, 0.05, 0.05)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "gripper" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.01
            double3 xformOp:translate = (0.6599999999999999, -0.32, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "FixedJaw" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/RobotIsaac/Looks/PhysicsMat> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                double size = 1
                float3 xformOp:scale = (0.06, 0.008, 0.03)
                double3 xformOp:translate = (0.06, 0.055, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def PhysicsRevoluteJoint "joint_base_yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 2000
            float drive:angular:physics:maxForce = 200
            float drive:angular:physics:stiffness = 100000
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/RobotIsaac/base>
            rel physics:body1 = </World/RobotIsaac/link0>
            point3f physics:localPos0 = (0, 0, 0.35)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -166.15776
            float physics:upperLimit = 166.15776
        }

        def PhysicsRevoluteJoint "joint_shoulder" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 2000
            float drive:angular:physics:maxForce = 200
            float drive:angular:physics:stiffness = 100000
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/RobotIsaac/link0>
            rel physics:body1 = </World/RobotIsaac/link1>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -97.402824
            float physics:upperLimit = 97.402824
        }

        def PhysicsRevoluteJoint "joint_elbow" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 2000
            float drive:angular:physics:maxForce = 200
            float drive:angular:physics:stiffness = 100000
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/RobotIsaac/link1>
            rel physics:body1 = </World/RobotIsaac/link2>
            point3f physics:localPos0 = (0.3, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -2.864789
            float physics:upperLimit = 148.96902
        }

        def PhysicsRevoluteJoint "joint_wrist_pitch" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 2000
            float drive:angular:physics:maxForce = 200
            float drive:angular:physics:stiffness = 100000
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/RobotIsaac/link2>
            rel physics:body1 = </World/RobotIsaac/wrist>
            point3f physics:localPos0 = (0.3, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -166.15776
            float physics:upperLimit = 166.15776
        }

        def PhysicsRevoluteJoint "joint_wrist_roll" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 2000
            float drive:angular:physics:maxForce = 200
            float drive:angular:physics:stiffness = 100000
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "X"
            rel physics:body0 = </World/RobotIsaac/wrist>
            rel physics:body1 = </World/RobotIsaac/gripper>
            point3f physics:localPos0 = (0.06, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -174.75212
            float physics:upperLimit = 174.75212
        }

        def Xform "jaw" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.005
            double3 xformOp:translate = (0.72, -0.375, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Visual" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/RobotIsaac/Looks/PhysicsMat> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                double size = 1
                float3 xformOp:scale = (0.06, 0.008, 0.03)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def PhysicsPrismaticJoint "jaw_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 2000
            float drive:linear:physics:maxForce = 50
            float drive:linear:physics:stiffness = 100000
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/RobotIsaac/gripper>
            rel physics:body1 = </World/RobotIsaac/jaw>
            point3f physics:localPos0 = (0.06, -0.055, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.07
        }
    }
}

